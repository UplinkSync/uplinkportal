# UplinkPortal environment template (public-safe placeholders only).
# IMPORTANT:
# - Do not commit real values.
# - The plugin does not auto-load `.env` by itself.
# - Map these values in `wp-config.php`, a must-use plugin bootstrap, or deployment tooling.

##############################
# Minimal required for local dev
##############################

# Plugin runtime mode used by your bootstrap/deployment logic (not read directly by plugin code).
UPLINKPORTAL_ENV=local

# Used by secret encryption key derivation when defining the UPLINKPORTAL_CRYPTO_SALT constant in wp-config.php.
# Reference: uplinkportal.php (UPLINKPORTAL_CRYPTO_SALT), src/Core/Licensing/SecretsStore.php (derive_key()).
UPLINKPORTAL_CRYPTO_SALT=replace-with-project-specific-crypto-salt

# Backend runtime connectivity mode and base URL.
# Allowed mode values: mock | staging | production.
# Use `mock` for local/offline testing, `staging` for pre-prod integration checks, `production` for live internet-connected runs.
# Reference: src/Core/Support/Options.php (get_backend_runtime_mode(), get_backend_base_url()).
UPLINKPORTAL_BACKEND_MODE=staging
UPLINKPORTAL_BACKEND_BASE_URL=https://backend.local.test

# Backend service token used for delegated backend requests (for example document key exchange).
# Reference: src/Core/Licensing/SecretsStore.php (uplinkportal_secret_backend_service_token),
# src/Core/Support/ClientDocumentsStore.php (fetch_key_from_backend()),
# src/Core/Security/SecurityAlertMonitor.php (dispatch alerts).
UPLINKPORTAL_BACKEND_SERVICE_TOKEN=replace-with-backend-service-token

# Optional backend paths (effective path used by delegated backend checks/services).
# Defaults if unset: /v1/validate and /health.
# Reference: src/Core/Support/Options.php (get_backend_validation_path(), get_backend_health_path()).
UPLINKPORTAL_BACKEND_VALIDATION_PATH=/v1/validate
UPLINKPORTAL_BACKEND_HEALTH_PATH=/health

# Optional alias for tooling that mirrors option-key naming.
UPLINKPORTAL_SECRET_BACKEND_SERVICE_TOKEN=replace-with-backend-service-token

# Backend path for client document key endpoint.
# Reference: filter `uplinkportal_client_documents_key_endpoint` in src/Core/Support/ClientDocumentsStore.php.
UPLINKPORTAL_CLIENT_DOCUMENTS_KEY_ENDPOINT=/uplinkportal/v1/client-documents/key

# Validation profile base URLs (billing/helpdesk/pm).
# Reference: src/Core/Support/Options.php (validation_profiles), src/Admin/SettingsPage.php (validation UI).
UPLINKPORTAL_VALIDATION_BILLING_BASE_URL=https://backend.local.test/billing
UPLINKPORTAL_VALIDATION_HELPDESK_BASE_URL=https://backend.local.test/helpdesk
UPLINKPORTAL_VALIDATION_PM_BASE_URL=https://backend.local.test/projects

# Validation profile API keys (stored as secrets options).
# Reference: src/Core/Licensing/SecretsStore.php (validation_api_key_option()).
UPLINKPORTAL_VALIDATION_BILLING_API_KEY=replace-with-billing-api-key
UPLINKPORTAL_VALIDATION_HELPDESK_API_KEY=replace-with-helpdesk-api-key
UPLINKPORTAL_VALIDATION_PM_API_KEY=replace-with-pm-api-key

##############################
# Optional / Production
##############################

# Optional direct encryption-key override (generally prefer backend endpoint + service token).
# Reference: filter `uplinkportal_client_documents_encryption_key` in src/Core/Support/ClientDocumentsStore.php.
UPLINKPORTAL_CLIENT_DOCUMENTS_ENCRYPTION_KEY=

# Optional backend validation feature switch for your wrapper logic (plugin uses delegated filter callbacks).
# Reference: filter `uplinkportal_backend_validation_result` in src/Core/Support/BackendValidationBroker.php.
UPLINKPORTAL_BACKEND_VALIDATION_ENABLED=1

# Vault routing metadata / opaque connection reference.
# Reference: src/Core/Support/Options.php (get_secret_manager_config()),
# src/Core/Licensing/SecretsStore.php (uplinkportal_secret_vault_connection_ref).
UPLINKPORTAL_SECRET_MANAGER_PROVIDER=vault
UPLINKPORTAL_VAULT_ADDR=https://vault.example.com
UPLINKPORTAL_VAULT_NAMESPACE=admin
UPLINKPORTAL_VAULT_KV_MOUNT=kv
UPLINKPORTAL_VAULT_PATH_PREFIX=uplinkportal
UPLINKPORTAL_VAULT_AUTH_MOUNT=approle
UPLINKPORTAL_VAULT_ROLE=uplinkportal-backend
UPLINKPORTAL_VAULT_CONNECTION_REF=vault_ref_opaque

# OAuth delegated opaque references (per integration model).
# Reference: src/Core/Licensing/SecretsStore.php (uplinkportal_secret_oauth_connection_*),
# src/Core/Support/Options.php (get_integration_profiles()).
UPLINKPORTAL_OAUTH_CONNECTION_REF_FINANCE=conn_ref_finance_opaque
UPLINKPORTAL_OAUTH_CONNECTION_REF_IT_SUPPORT=conn_ref_it_support_opaque
UPLINKPORTAL_OAUTH_CONNECTION_REF_PROJECTS=conn_ref_projects_opaque
UPLINKPORTAL_OAUTH_CONNECTION_REF_LICENSING=conn_ref_licensing_opaque
UPLINKPORTAL_OAUTH_CONNECTION_REF_DOCUMENTS=conn_ref_documents_opaque

# Transport/security policy controls for wrapper/filter wiring.
# Reference: src/Core/Support/TransportSecurityPolicy.php,
# src/ClientPortal/Rest/PortalController.php (`uplinkportal_enforce_rest_nonce`).
UPLINKPORTAL_ENFORCE_REST_NONCE=1
UPLINKPORTAL_ALLOW_INSECURE_TRANSPORT=0
UPLINKPORTAL_SECRET_MAX_AGE_DAYS=90

# Data-protection and KMS posture values for deployment/bootstrap tooling.
# Reference: src/Core/Support/Options.php (get_data_protection_profile()).
UPLINKPORTAL_DATA_PROTECTION_AT_REST_STATUS=disabled
UPLINKPORTAL_DATA_PROTECTION_DATABASE_ENCRYPTION=none
UPLINKPORTAL_DATA_PROTECTION_DOCUMENT_ENCRYPTION=plugin_local_encrypted
UPLINKPORTAL_DATA_PROTECTION_KMS_PROVIDER=none
UPLINKPORTAL_DATA_PROTECTION_KEY_ROTATION_DAYS=90

# Optional monitoring configuration.
# Reference: src/Core/Support/Options.php (get_monitoring_profile()).
UPLINKPORTAL_MONITORING_MODE=none
UPLINKPORTAL_MONITORING_WEBHOOK_URL=

# CI/local automation toggles for shell wrappers (not read directly by plugin code).
UPLINKPORTAL_CI_RUN_PHP_LINT=1
UPLINKPORTAL_CI_RUN_LINT=1
UPLINKPORTAL_CI_RUN_TESTS=1
UPLINKPORTAL_CI_RUN_HYGIENE_SCAN=1
