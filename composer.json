{
  "name": "uplinkportal/uplinkportal",
  "description": "Public core framework for the UplinkPortal WordPress plugin",
  "type": "wordpress-plugin",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcsstandards/phpcsutils": "^1.0",
    "phpcsstandards/phpcsextra": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "UplinkPortal\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UplinkPortal\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c tests/phpunit.xml.dist",
    "phpcs": "phpcs --standard=tests/phpcs.xml.dist",
    "phpcbf": "phpcbf --standard=tests/phpcs.xml.dist",
    "spellcheck": "node infrastructure/scripts/run-cspell.mjs",
    "check-ui-placeholders": "bash infrastructure/scripts/check-ui-placeholders.sh",
    "lint": [
      "@phpcs",
      "@spellcheck",
      "@check-ui-placeholders"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
